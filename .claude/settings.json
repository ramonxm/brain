{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-notes.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Validando a nota contra o template"
          }
        ]
      }
    ]
  }
}
